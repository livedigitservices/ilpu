# Express Server Port
PORT=5000

# Admin Email for Receiving Automated Booking & Payment Receipts
ADMIN_EMAIL=drrajeshkumar.ilpu@gmail.com

# MongoDB Database Connection String (Local MongoDB or MongoDB Atlas Cloud)
# Local: mongodb://127.0.0.1:27017/ilpu_legal
# Cloud: mongodb+srv://<username>:<password>@cluster.mongodb.net/ilpu_legal?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ilpu_legal

# SMTP Mail Server Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password

# PayPal API Credentials (Sandbox / Live)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
